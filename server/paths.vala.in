namespace Argus.Server
{
	/**
	 * Configuration directory from the build.
	 *
	 * ''sysconfdir'' plus ''argusrm''. The default build is
	 * ''/etc/argusrm''. ''socket'' and ''download'' are the
	 * listen lines under this directory.
	 */
	public const string SYSCONFDIR = "@SYSCONFDIR@";

	/**
	 * File store from the build.
	 *
	 * ''localstatedir'' plus ''lib/argusrm''. The default build
	 * is ''/var/lib/argusrm''. Certificates live under ''tls/''.
	 * Downloadable files live under ''packages/''. Osquery installers
	 * live under ''packages/osquery/''.
	 */
	public const string LOCALSTATEDIR = "@LOCALSTATEDIR@";

	/**
	 * App socket port from the build.
	 *
	 * A system port, under 1024. The default build is 817.
	 * ''/etc/argusrm/socket'' and ''--socket'' replace the
	 * whole address.
	 */
	public const int SOCKET_PORT = @SOCKET_PORT@;

	/**
	 * Download socket port from the build.
	 *
	 * A system port, under 1024. The default build is 818.
	 * ''/etc/argusrm/download'' and ''--download'' replace
	 * the whole address.
	 */
	public const int DOWNLOAD_PORT = @DOWNLOAD_PORT@;
}
