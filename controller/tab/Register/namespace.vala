/**
 * Agent / Controller registration sidebar page: registered
 * machines and the pending queue.
 *
 * {@link Argus.Controller.Tab.Register.Agent} switches {@link Current}
 * and {@link Pending}. {@link Argus.Controller.Tab.Assets} is the same
 * pattern for machines and software.
 *
 * == Example ==
 *
 * {{{
 * var page = new Argus.Controller.Tab.Register.Agent(window);
 * pages.add_named(page, "registration");
 * }}}
 */
namespace Argus.Controller.Tab.Register
{
	internal class NamespaceDoc {}
}