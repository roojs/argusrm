[Unit]
Description=Argus remote management agent
After=network-online.target dbus.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/argus-agent
Restart=on-failure
RestartSec=5s
StateDirectory=argusrm-agent
Environment=XDG_DATA_HOME=/var/lib/argusrm-agent

[Install]
WantedBy=multi-user.target
