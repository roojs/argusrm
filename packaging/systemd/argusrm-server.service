[Unit]
Description=Argus Remote Manager server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/argusrm-server
Restart=on-failure
RestartSec=5s
StateDirectory=argusrm
StateDirectoryMode=0700
ConfigurationDirectory=argusrm
LogsDirectory=argusrm
Environment=ARGUS_LOG_DIR=/var/log/argusrm

[Install]
WantedBy=multi-user.target
