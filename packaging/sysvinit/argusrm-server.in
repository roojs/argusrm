#!/bin/sh
### BEGIN INIT INFO
# Provides:          argusrm-server
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Argus Remote Manager server
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin
DESC="Argus Remote Manager server"
NAME=argusrm-server
DAEMON=@SERVER_EXECUTABLE@
PIDFILE=/run/$NAME.pid
export ARGUS_LOG_DIR=@LOG_DIR@

. /lib/lsb/init-functions

case "$1" in
	start)
		log_daemon_msg "Starting $DESC" "$NAME"
		mkdir -p @SERVER_DATA_DIR@ @SERVER_SYSCONFDIR@ "$ARGUS_LOG_DIR"
		start-stop-daemon --start --quiet --background --make-pidfile --pidfile "$PIDFILE" --exec "$DAEMON"
		log_end_msg $?
		;;
	stop)
		log_daemon_msg "Stopping $DESC" "$NAME"
		start-stop-daemon --stop --quiet --retry=TERM/30/KILL/5 --pidfile "$PIDFILE" --exec "$DAEMON"
		RESULT=$?
		if [ "$RESULT" -eq 0 ]; then
			rm -f "$PIDFILE"
		fi
		log_end_msg "$RESULT"
		;;
	restart|force-reload)
		"$0" stop
		"$0" start
		;;
	status)
		status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME"
		;;
	*)
		echo "Usage: $0 {start|stop|restart|force-reload|status}"
		exit 1
		;;
esac

exit 0
