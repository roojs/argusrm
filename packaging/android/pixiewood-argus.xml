<?xml version="1.0" encoding="UTF-8"?>
<app xmlns="https://sp1rit.arpa/pixiewood/"
     xmlns:meta="https://specifications.freedesktop.org/metainfo/1.0">
  <metainfo vercalc="sem121010">
    <meta:component type="desktop-application">
      <meta:id>org.roojs.argus</meta:id>
      <meta:name>Argus Agent</meta:name>
      <meta:summary>Argus remote management agent</meta:summary>
      <meta:metadata_license>CC0-1.0</meta:metadata_license>
      <meta:project_license>LGPL-3.0-or-later</meta:project_license>
      <meta:description>
        <meta:p>Enroll this device with an Argus management server.</meta:p>
      </meta:description>
      <meta:requires>
        <meta:internet>always</meta:internet>
      </meta:requires>
      <meta:releases>
        <meta:release version="0.1.0" date="2026-11-03"/>
      </meta:releases>
