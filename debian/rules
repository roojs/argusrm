#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	meson setup build-debian --prefix=/usr --sysconfdir=/etc --localstatedir=/var -Ddocs=false

override_dh_auto_build:
	meson compile -C build-debian

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/tmp meson install -C build-debian

override_dh_auto_test:
	# No automated test suite yet.

override_dh_installsystemd:
	dh_installsystemd -pargusrm-server
	dh_installsystemd -pargusrm-agent --no-enable --no-start

override_dh_installinit:
	dh_installinit -pargusrm-server
	dh_installinit -pargusrm-agent --no-enable --no-start
